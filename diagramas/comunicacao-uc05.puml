@startuml Comunicacao UC-05 - Aprovar Orcamento
!pragma layout smetana
skinparam rectangle {
  BackgroundColor #EEF2FF
  BorderColor #4F46E5
}
skinparam actor {
  BackgroundColor #DBEAFE
  BorderColor #2563EB
}
skinparam ArrowColor #4F46E5
skinparam roundcorner 8

title Diagrama de Comunicação — Realização do UC-05 Aprovar Orçamento

actor "Cliente" as C
rectangle ":OrcamentoController" as OC
rectangle ":OrcamentoService" as OS
rectangle ":OrcamentoRepository" as OR
rectangle ":OrdemServicoRepository" as OSR
rectangle ":NotificacaoService" as NS

C -> OC : 1: aprovarOrcamento(id)
OC -> OS : 1.1: aprovar(id)
OS -> OR : 1.1.1: findById(id)
OS -> OR : 1.1.2: save(orcamento aprovado)
OS -> OSR : 1.1.3: atualizarStatus(os, APROVADA)
OS -> NS : 1.1.4: notificarMecanico(os)
OC <-- OS : 1.2: OrcamentoDTO
C <-- OC : 2: "Orçamento aprovado"

@enduml
