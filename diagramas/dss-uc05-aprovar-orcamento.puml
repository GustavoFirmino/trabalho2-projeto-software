@startuml DSS UC-05 - Aprovar Orcamento
skinparam sequenceArrowThickness 2
skinparam sequence {
  ActorBackgroundColor #DBEAFE
  ActorBorderColor #2563EB
  ParticipantBackgroundColor #EEF2FF
  ParticipantBorderColor #4F46E5
  ArrowColor #4F46E5
  LifeLineBorderColor #A5B4FC
}
skinparam roundcorner 8

title DSS — UC-05 Aprovar Orçamento

actor "Cliente" as C
participant ":Sistema AutoFix" as S

C -> S : consultarOrcamento(numeroOS)
S --> C : orçamento detalhado\n(serviços, peças, valor total)

alt Cliente aprova
  C -> S : aprovarOrcamento(numeroOS)
  S --> C : orçamento aprovado\nOS liberada para execução
  S -> S : notificarMecanicoResponsavel()
else Cliente recusa
  C -> S : recusarOrcamento(numeroOS, motivo)
  S --> C : orçamento recusado\nOS encerrada sem execução
end

@enduml
